{
  "name": "bimola-menu",
  "private": true,
  "type": "module",
  "description": "Bi Mola QR-menukaart (Cloudflare Pages + D1) en beheerpagina (Worker achter Cloudflare Access).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:menu": "wrangler pages dev",
    "dev:admin": "wrangler dev -c wrangler.admin.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply bimola --local",
    "db:migrate:remote": "wrangler d1 migrations apply bimola --remote",
    "seed:sql": "node scripts/seed-from-csv.mjs",
    "deploy:admin": "wrangler deploy -c wrangler.admin.jsonc"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261116.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
