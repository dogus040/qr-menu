// Beheerpagina: Worker "admin" op https://admin.bimolakafe.com (eigen domein, werkt ook in Turkije),
// volledig achter Cloudflare Access.
// Geheimen (niet in deze repo): OWNER_EMAILS, CF_API_TOKEN  →  wrangler secret put … -c wrangler.admin.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "admin",
  "main": "src/admin/index.ts",
  "compatibility_date": "2026-11-01",
  // Oud adres admin.bimola.workers.dev uitgezet (Dogus, 2026-11-25): alleen het eigen domein.
  "workers_dev": false,
  // Eigen domein: Cloudflare maakt DNS-record en certificaat aan. De hostname moet ook in de Access-app staan.
  "routes": [{ "pattern": "admin.bimolakafe.com", "custom_domain": true }],
  // Preview-URL's zouden buiten de Access-bescherming kunnen vallen.
  "preview_urls": false,
  "assets": {
    "directory": "./admin-public",
    "binding": "ASSETS",
    // Elke aanvraag eerst langs de Worker: beveiligingsheaders en JWT-controle ook voor de pagina zelf.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bimola",
      "database_id": "ef2c2e1c-33e3-4587-929d-405cd02819d6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Teamdomein van Cloudflare Zero Trust, bijv. "bimola.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "tiny-smoke-594d.cloudflareaccess.com",
    // "Application Audience (AUD) Tag" van de Access-applicatie.
    "ACCESS_AUD": "aa202ede8b72a2e77f03644d9db8d415b5064784a0edd594f7b1165f2e92e079",
    // Account en Access-groep "Bi Mola beheerders" (witte lijst).
    "ACCESS_ACCOUNT_ID": "9344f92aee27addf23df28b2b20c91af",
    "ACCESS_GROUP_ID": "b476219f-83ce-4827-9887-7ce586d4173b",
    // Adres van de menukaart (QR-code, knop "Menüyü aç"): eigen domein, niet *.pages.dev (geblokkeerd in Turkije).
    "PUBLIC_MENU_URL": "https://menu.bimolakafe.com/"
  },
  // Snelheidslimieten (Dogus, 2026-11-27), per minuut: per IP 300 verzoeken (alles), per account 60 wijzigingen.
  // namespace_id geldt voor het hele Cloudflare-account: de test heeft eigen nummers, dus eigen tellers.
  "ratelimits": [
    { "name": "RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RATE_LIMIT_ACCOUNT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Testomgeving (Dogus, 2026-11-25): Worker "admin-test" op admin-test.bimolakafe.com met een eigen database
  // en een eigen witte lijst (tabel dev_admin_emails), zodat testen nooit de echte Access-groep of menudata raakt.
  // Uitrol: push naar branch "test" (CI, job deploy-test). Eenmalig geheim (Dogus):
  //   npx wrangler secret put OWNER_EMAILS -c wrangler.admin.jsonc --env test
  // Overgeërfd van boven: main, compatibility_date, workers_dev, preview_urls, assets, observability.
  "env": {
    "test": {
      "name": "admin-test",
      "routes": [{ "pattern": "admin-test.bimolakafe.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bimola-test",
          "database_id": "4eb33051-e786-4ae0-b32b-c0c0b6cf7d9e",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT_IP", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "RATE_LIMIT_ACCOUNT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": {
        // Zelfde Access-app als productie (admin-test.bimolakafe.com staat daar ook in), dus dezelfde AUD.
        "ACCESS_TEAM_DOMAIN": "tiny-smoke-594d.cloudflareaccess.com",
        "ACCESS_AUD": "aa202ede8b72a2e77f03644d9db8d415b5064784a0edd594f7b1165f2e92e079",
        // Geen ACCESS_ACCOUNT_ID/ACCESS_GROUP_ID: de witte lijst staat in de testdatabase, nooit in de echte Access-groep.
        "ACCESS_DIRECTORY": "d1",
        "PUBLIC_MENU_URL": "https://test.bimolakafe.com/"
      }
    }
  }
}
