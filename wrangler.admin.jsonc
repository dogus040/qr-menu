// Beheerpagina: Worker "admin" op https://admin.bimolakafe.com (eigen domein, werkt ook in Turkije),
// volledig achter Cloudflare Access.
// Geheimen (niet in deze repo): OWNER_EMAILS, CF_API_TOKEN  →  wrangler secret put … -c wrangler.admin.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "admin",
  "main": "src/admin/index.ts",
  "compatibility_date": "2026-11-01",
  // Oud adres admin.bimola.workers.dev uitgezet (Dogus, 2026-11-25): alleen het eigen domein.
  "workers_dev": false,
  // Eigen domein: Cloudflare maakt DNS-record en certificaat aan. De hostname moet ook in de Access-app staan.
  "routes": [{ "pattern": "admin.bimolakafe.com", "custom_domain": true }],
  // Preview-URL's zouden buiten de Access-bescherming kunnen vallen.
  "preview_urls": false,
  "assets": {
    "directory": "./admin-public",
    "binding": "ASSETS",
    // Elke aanvraag eerst langs de Worker: beveiligingsheaders en JWT-controle ook voor de pagina zelf.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bimola",
      "database_id": "ef2c2e1c-33e3-4587-929d-405cd02819d6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Teamdomein van Cloudflare Zero Trust, bijv. "bimola.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "tiny-smoke-594d.cloudflareaccess.com",
    // "Application Audience (AUD) Tag" van de Access-applicatie.
    "ACCESS_AUD": "aa202ede8b72a2e77f03644d9db8d415b5064784a0edd594f7b1165f2e92e079",
    // Account en Access-groep "Bi Mola beheerders" (witte lijst).
    "ACCESS_ACCOUNT_ID": "9344f92aee27addf23df28b2b20c91af",
    "ACCESS_GROUP_ID": "b476219f-83ce-4827-9887-7ce586d4173b",
    // Adres van de menukaart (QR-code, knop "Menüyü aç"): eigen domein, niet *.pages.dev (geblokkeerd in Turkije).
    "PUBLIC_MENU_URL": "https://menu.bimolakafe.com/"
  },
  "observability": { "enabled": true }
}
